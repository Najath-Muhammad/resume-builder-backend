# ============================================================
# AI Resume Builder — Backend .gitignore
# ============================================================

# Dependencies
node_modules/

# Build output
dist/
.nest/

# env files — never commit real secrets
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored (safe template for other devs)

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Testing
coverage/
